[Unit]
Description=Dyzury Telegram bot (doctor shift/duty hour tracker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dyzurybot
WorkingDirectory=/opt/dyzury-bot
ExecStart=/opt/dyzury-bot/.venv/bin/python /opt/dyzury-bot/bot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Belt-and-suspenders: the bot never listens on a network port (long-polling,
# outbound only), so it doesn't need broad filesystem/network access.
# PrivateTmp gives it its own writable /tmp -- openpyxl needs a real temp dir
# internally when saving worksheets, ProtectSystem=strict alone hides /tmp.
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/opt/dyzury-bot/data

[Install]
WantedBy=multi-user.target
